generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailNormalized String    @unique
  passwordHash    String?
  googleId        String?   @unique
  emailVerifiedAt DateTime?
  role            String    @default("user")
  mustChangePassword Boolean @default(false)
  disabledAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  lastLoginAt     DateTime?

  profile             Profile?
  sessions            Session[]
  verificationTokens  EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  clientApps          ClientApp[]
  authorizationCodes  AuthorizationCode[]
  accessTokens        AccessToken[]
}

model Profile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  displayName        String?
  username           String?  @unique
  usernameNormalized String?  @unique
  bio                String?
  avatarUrl          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SignupVerification {
  id              String    @id @default(cuid())
  email           String
  emailNormalized String    @unique
  codeHash        String
  expiresAt       DateTime
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String?
  targetUserId String?
  action       String
  metadata     String?
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([action])
  @@index([createdAt])
}

model AuthorizationCode {
  id          String    @id @default(cuid())
  clientAppId String
  userId      String
  redirectUri String
  codeHash    String    @unique
  scope       String?
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  clientApp ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientAppId])
}

model AccessToken {
  id          String    @id @default(cuid())
  clientAppId String
  userId      String
  tokenHash   String    @unique
  scope       String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  clientApp ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([clientAppId])
}

model ClientApp {
  id               String        @id @default(cuid())
  name             String
  slug             String        @unique
  description      String?
  homepageUrl      String?
  logoUrl          String?
  clientId         String        @unique
  clientSecretHash String
  ownerUserId      String?
  isActive         Boolean       @default(true)
  brandColor       String?
  bgColor          String?
  bgImageUrl       String?
  selfService      Boolean       @default(true)
  contactEmail     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  owner       User?         @relation(fields: [ownerUserId], references: [id], onDelete: SetNull)
  redirectUris RedirectUri[]
  authorizationCodes AuthorizationCode[]
  accessTokens       AccessToken[]

  @@index([ownerUserId])
}

model RedirectUri {
  id          String   @id @default(cuid())
  clientAppId String
  uri         String
  createdAt   DateTime @default(now())

  clientApp ClientApp @relation(fields: [clientAppId], references: [id], onDelete: Cascade)

  @@unique([clientAppId, uri])
  @@index([clientAppId])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())
  expiresAt   DateTime

  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
